# Configurações do Banco de Dados PostgreSQL (Schemas: registration, auth, guilds, gamification)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tech_guilds
SQL_ECHO=false

# Mensageria e Event-Driven com NATS JetStream
NATS_URL=nats://localhost:4222

# Autenticação e Segurança (JWT)
JWT_SECRET=tech-guilds-development-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Integrações SSO Corporativo (Google Workspace, GitHub Enterprise, Azure AD)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Notificações e Webhooks de Squad
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Configuração de Execução
PORT=8000
ENVIRONMENT=development
TESTING=false
